rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users collection: Sirf logged-in users apna data read/write kar sakte hain
    match /users/{document} {
      allow read, write: if request.auth != null;
    }

    // 2. Biodatas collection: Logged-in user write karega, public read kar sakti hai
    match /biodatas/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Slugs collection: Link share karne ke liye public read allowed
    match /slugs/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
